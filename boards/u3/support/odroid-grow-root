#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
marker=/var/lib/odroid-image/root-expanded
[[ ! -e "$marker" ]] || exit 0
# Generated by image assembly, rather than a build-host shell file.
# shellcheck source=/dev/null
source /etc/odroid-image-release
[[ $TARGET == ODROID-U3-armhf && -n $ROOT_UUID ]]
root_source=$(findmnt -n -o SOURCE /)
[[ $root_source =~ ^/dev/mmcblk[0-9]+p2$ ]]
[[ $(blkid -s UUID -o value "$root_source") == "$ROOT_UUID" ]]
disk=${root_source%p2}
result=$(growpart "$disk" 2 2>&1) || {
    code=$?
    printf '%s\n' "$result"
    [[ $code == 1 && $result == NOCHANGE:* ]] || exit "$code"
}
printf '%s\n' "$result"
resize2fs "$root_source"
install -d -m 755 /var/lib/odroid-image
touch "$marker"
