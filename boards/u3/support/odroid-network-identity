#!/usr/bin/python3
"""Generate the U3 link identity before udev coldplug; never write hardware."""
import argparse
import json
from pathlib import Path
import re
import sys


def valid_mac(value):
    if not re.fullmatch(r"[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}", value):
        return False
    raw = bytes.fromhex(value.replace(":", ""))
    return raw not in (bytes(6), b"\xff" * 6) and not raw[0] & 1


def derive_mac(serial):
    if not re.fullmatch(r"[0-9a-fA-F]{16}", serial):
        raise ValueError("No valid 64-bit Exynos hardware serial")
    uid = int(serial, 16)
    if uid in (0, 0xffffffffffffffff):
        raise ValueError("Empty Exynos hardware serial")
    # Fixed v1 contract: low 16 bits of GUID_HIGH, then GUID_LOW, big endian.
    raw = bytearray((uid & 0xffffffffffff).to_bytes(6, "big"))
    raw[0] = (raw[0] & 0xfe) | 0x02  # locally administered unicast
    return ":".join(f"{byte:02x}" for byte in raw)


def identity(root):
    soc = root / "sys/devices/soc0"
    if (soc / "soc_id").read_text().strip() != "EXYNOS4412":
        raise ValueError("This identity method is only for Exynos4412")
    nic = root / "sys/class/net/eth0"
    if (nic / "addr_assign_type").is_file():
        address = (nic / "address").read_text().strip().lower()
        if (nic / "addr_assign_type").read_text().strip() == "0" and valid_mac(address):
            return {"mac": address, "source": "permanent address supplied by Ethernet driver"}
    serial = (soc / "serial_number").read_text().strip()
    return {"mac": derive_mac(serial), "source": "Exynos4412 hardware GUID, algorithm v1"}


def generate(root):
    result = identity(root)
    directory = root / "run/systemd/network"
    directory.mkdir(parents=True, exist_ok=True)
    target = directory / "10-odroid-u3.link"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(
        "# Generated from this board's hardware identity; no EEPROM writes.\n"
        "[Match]\nDriver=smsc95xx\nPath=platform-12580000.*-usb-0:2:1.0\n\n"
        "[Link]\nNamePolicy=keep kernel\nMACAddressPolicy=none\n"
        f"MACAddress={result['mac']}\n")
    temporary.chmod(0o644)
    temporary.replace(target)
    state = root / "run/odroid-network-identity.json"
    state.write_text(json.dumps(result, indent=2) + "\n")
    state.chmod(0o644)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("generate", "status"))
    parser.add_argument("--root", type=Path, default=Path("/"), help="alternate root for offline verification")
    args = parser.parse_args()
    try:
        result = generate(args.root) if args.action == "generate" else identity(args.root)
        print(json.dumps(result, indent=2))
    except (OSError, ValueError) as error:
        print(f"odroid-network-identity: {error}; leaving default network policy available", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
