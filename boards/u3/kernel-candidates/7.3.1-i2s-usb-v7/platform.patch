diff --git a/drivers/soc/samsung/exynos-chipid.c b/drivers/soc/samsung/exynos-chipid.c
--- a/drivers/soc/samsung/exynos-chipid.c
+++ b/drivers/soc/samsung/exynos-chipid.c
@@ -198,6 +198,24 @@
 	if (!soc_dev_attr->soc_id)
 		return dev_err_probe(dev, -ENODEV, "Unknown SoC\n");
 
+	/* The Exynos4412 GUID is independent of the SD/eMMC installation. */
+	if (soc_info.product_id == 0xE4412000) {
+		u32 uid_low, uid_high;
+
+		ret = regmap_read(regmap, EXYNOS_CHIPID_REG_LOT_ID, &uid_low);
+		if (!ret)
+			ret = regmap_read(regmap, 0x18, &uid_high);
+		if (!ret && (uid_low || uid_high) &&
+		    (uid_low != U32_MAX || uid_high != U32_MAX)) {
+			soc_dev_attr->serial_number = devm_kasprintf(&pdev->dev,
+				GFP_KERNEL, "%08x%08x", uid_high, uid_low);
+			if (!soc_dev_attr->serial_number)
+				return -ENOMEM;
+		} else {
+			dev_warn(&pdev->dev, "Exynos4412 GUID unavailable\n");
+		}
+	}
+
 	/* please note that the actual registration will be deferred */
 	soc_dev = soc_device_register(soc_dev_attr);
 	if (IS_ERR(soc_dev))
