+// SPDX-License-Identifier: GPL-2.0-only
+/* Private, opt-in U3 observation at an existing RCU stall tracepoint. */
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/odroid-u3-i2cdiag.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip/arm-gic.h>
+#include <linux/jiffies.h>
+#include <linux/kernel_stat.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/smp.h>
+#include <linux/string.h>
+#include <trace/events/rcu.h>
+
+static bool u3_diag_enabled;
+static void __iomem *u3_dist, *u3_cpu, *u3_mct;
+static unsigned int u3_timer_irq;
+static atomic_t u3_diag_busy = ATOMIC_INIT(0);
+static atomic_t u3_diag_reports = ATOMIC_INIT(0);
+
+static int __init u3_diag_setup(char *value)
+{
+	return !kstrtobool(value, &u3_diag_enabled);
+}
+__setup("odroid_u3_irqdiag=", u3_diag_setup);
+
+struct u3_diag_bank {
+	u32 dctl, enabled, pending, active, target;
+	u32 cctl, pmr, bpr, rpr, hppir;
+	u32 tcntb, icntb, tcon, status, inten, wstat;
+	u32 irqs;
+	u32 pri[5];
+};
+
+
+/* Opt-in progress stores only; snapshots are approximate, not atomic. */
+bool odroid_u3_i2cdiag_enabled;
+unsigned int odroid_u3_i2cdiag_irq;
+EXPORT_SYMBOL_GPL(odroid_u3_i2cdiag_enabled);
+EXPORT_SYMBOL_GPL(odroid_u3_i2cdiag_irq);
+static bool u3_i2c_requested;
+struct u3_i2c_progress { u32 stage, count, value, aux, pid, tick; };
+static struct u3_i2c_progress u3_progress[4][U3DIAG_CHANNELS];
+
+static int __init u3_i2c_setup(char *value)
+{
+	return !kstrtobool(value, &u3_i2c_requested);
+}
+__setup("odroid_u3_i2cdiag=", u3_i2c_setup);
+
+void odroid_u3_i2cdiag_mark(unsigned int channel, u32 stage, u32 value, u32 aux)
+{
+	unsigned int cpu = raw_smp_processor_id();
+	struct u3_i2c_progress *p;
+	if (!odroid_u3_i2cdiag_on() || cpu >= 4 || channel >= U3DIAG_CHANNELS)
+		return;
+	p = &u3_progress[cpu][channel];
+	WRITE_ONCE(p->value, value);
+	WRITE_ONCE(p->aux, aux);
+	WRITE_ONCE(p->pid, current->pid);
+	WRITE_ONCE(p->tick, (u32)jiffies);
+	WRITE_ONCE(p->count, READ_ONCE(p->count) + 1);
+	WRITE_ONCE(p->stage, stage);
+}
+EXPORT_SYMBOL_GPL(odroid_u3_i2cdiag_mark);
+
+void odroid_u3_i2cdiag_bind(unsigned int irq)
+{
+	if (!odroid_u3_i2cdiag_on())
+		return;
+	WRITE_ONCE(odroid_u3_i2cdiag_irq, irq);
+	pr_info("U3I2CPROG bound irq=%u intid=90 register-base=13860000\n", irq);
+}
+EXPORT_SYMBOL_GPL(odroid_u3_i2cdiag_bind);
+
+static void u3_progress_copy(struct u3_i2c_progress dst[4][U3DIAG_CHANNELS])
+{
+	unsigned int cpu, ch;
+	for (cpu = 0; cpu < 4; cpu++)
+		for (ch = 0; ch < U3DIAG_CHANNELS; ch++) {
+			struct u3_i2c_progress *s = &u3_progress[cpu][ch], *d = &dst[cpu][ch];
+			d->stage = READ_ONCE(s->stage);
+			d->count = READ_ONCE(s->count);
+			d->value = READ_ONCE(s->value);
+			d->aux = READ_ONCE(s->aux);
+			d->pid = READ_ONCE(s->pid);
+			d->tick = READ_ONCE(s->tick);
+		}
+}
+
+static int u3_i2c_progress_show(struct seq_file *f, void *unused)
+{
+	struct u3_i2c_progress data[4][U3DIAG_CHANNELS];
+	unsigned int cpu, ch;
+	u3_progress_copy(data);
+	seq_printf(f, "enabled=%u irq=%u approximate=1\n", odroid_u3_i2cdiag_on(),
+			   READ_ONCE(odroid_u3_i2cdiag_irq));
+	for (cpu = 0; cpu < 4; cpu++)
+		for (ch = 0; ch < U3DIAG_CHANNELS; ch++) {
+			struct u3_i2c_progress *p = &data[cpu][ch];
+			seq_printf(f, "cpu=%u channel=%u stage=%u count=%u value=%08x aux=%08x pid=%u tick=%u\n",
+					   cpu, ch, p->stage, p->count, p->value, p->aux, p->pid, p->tick);
+		}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(u3_i2c_progress);
+
+/* Serialize first: contended calls must not consume completed-report budget. */
+static bool u3_diag_begin_report(bool limited)
+{
+	if (atomic_cmpxchg(&u3_diag_busy, 0, 1))
+		return false;
+	if (limited && atomic_read(&u3_diag_reports) >= 3) {
+		atomic_set_release(&u3_diag_busy, 0);
+		return false;
+	}
+	return true;
+}
+
+static void u3_diag_end_report(bool limited)
+{
+	if (limited)
+		atomic_inc(&u3_diag_reports);
+	/* Publish completion before another CPU can acquire the busy guard. */
+	atomic_set_release(&u3_diag_busy, 0);
+}
+
+/* Read-only GICv1/v2 distributor attributes; never acknowledge an IRQ here. */
+struct u3_diag_spi { u32 priority, target, config; };
+static void u3_diag_read_spi(void __iomem *dist, unsigned int id,
+			     struct u3_diag_spi *out)
+{
+	out->priority = readl_relaxed(dist + GIC_DIST_PRI + (id / 4) * 4);
+	out->target = readl_relaxed(dist + GIC_DIST_TARGET + (id / 4) * 4);
+	out->config = readl_relaxed(dist + GIC_DIST_CONFIG + (id / 16) * 4);
+}
+
+/* Same validated Exynos alias as the functional GIC driver's per-CPU base. */
+struct u3_diag_shared {
+	u32 typer, iidr;
+	bool valid;
+	u32 enabled[4], pending[4], active[4];
+	struct u3_diag_spi spi[2];
+};
+
+static void u3_diag_read_shared(void __iomem *dist, struct u3_diag_shared *out)
+{
+	unsigned int group;
+
+	memset(out, 0, sizeof(*out));
+	out->typer = readl_relaxed(dist + GIC_DIST_CTR);
+	out->iidr = readl_relaxed(dist + GIC_DIST_IIDR);
+	/* Four shared groups cover INTIDs32..159. Invalid views stay marked. */
+	out->valid = ((out->typer & 0x1f) + 1) * 32 >= 160;
+	if (!out->valid)
+		return;
+	for (group = 0; group < ARRAY_SIZE(out->enabled); group++) {
+		out->enabled[group] = readl_relaxed(dist + GIC_DIST_ENABLE_SET + 4 + group * 4);
+		out->pending[group] = readl_relaxed(dist + GIC_DIST_PENDING_SET + 4 + group * 4);
+		out->active[group] = readl_relaxed(dist + GIC_DIST_ACTIVE_SET + 4 + group * 4);
+	}
+	u3_diag_read_spi(dist, 90, &out->spi[0]);
+	u3_diag_read_spi(dist, 109, &out->spi[1]);
+}
+
+static void u3_diag_dump(const char *reason, bool limited)
+{
+	static struct u3_diag_bank bank[4];
+	static struct u3_diag_shared shared[4];
+	const unsigned int spi_ids[] = { 90, 109 };
+	const unsigned int pri_ids[] = { 0, 4, 8, 12, 28 };
+	static struct u3_i2c_progress progress[4][U3DIAG_CHANNELS];
+	u32 high1, low1, high2, low2, global_tcon;
+	unsigned int observer_begin, observer_end;
+	unsigned int cpu, group, i;
+
+	if (!u3_diag_begin_report(limited))
+		return;
+
+	observer_begin = raw_smp_processor_id();
+	u3_progress_copy(progress);
+	/* All snapshots precede console output. No acknowledge/clear writes. */
+	high1 = readl_relaxed(u3_mct + 0x104);
+	low1 = readl_relaxed(u3_mct + 0x100);
+	global_tcon = readl_relaxed(u3_mct + 0x240);
+	for (cpu = 0; cpu < ARRAY_SIZE(bank); cpu++) {
+		void __iomem *d = u3_dist + cpu * 0x4000;
+		void __iomem *c = u3_cpu + cpu * 0x4000;
+		void __iomem *t = u3_mct + 0x300 + cpu * 0x100;
+		struct u3_diag_bank *b = &bank[cpu];
+
+		u3_diag_read_shared(d, &shared[cpu]);
+		b->dctl = readl_relaxed(d);
+		b->enabled = readl_relaxed(d + 0x100);
+		b->pending = readl_relaxed(d + 0x200);
+		b->active = readl_relaxed(d + 0x300);
+		b->target = readl_relaxed(d + 0x800);
+		b->cctl = readl_relaxed(c);
+		b->pmr = readl_relaxed(c + 0x04);
+		b->bpr = readl_relaxed(c + 0x08);
+		b->rpr = readl_relaxed(c + 0x14);
+		b->hppir = readl_relaxed(c + 0x18);
+		b->tcntb = readl_relaxed(t);
+		b->icntb = readl_relaxed(t + 0x08);
+		b->tcon = readl_relaxed(t + 0x20);
+		b->status = readl_relaxed(t + 0x30);
+		b->inten = readl_relaxed(t + 0x34);
+		b->wstat = readl_relaxed(t + 0x40);
+		b->irqs = kstat_irqs_cpu(u3_timer_irq, cpu);
+		for (i = 0; i < ARRAY_SIZE(pri_ids); i++)
+			b->pri[i] = readl_relaxed(d + GIC_DIST_PRI + pri_ids[i]);
+	}
+	high2 = readl_relaxed(u3_mct + 0x104);
+	low2 = readl_relaxed(u3_mct + 0x100);
+	observer_end = raw_smp_processor_id();
+
+	pr_info("U3IRQDIAG reason=%s observer=%u irq=%u jiffies=%lu global=%08x:%08x->%08x:%08x gtcon=%08x\n",
+		reason, raw_smp_processor_id(), u3_timer_irq, jiffies,
+		high1, low1, high2, low2, global_tcon);
+	for (cpu = 0; cpu < ARRAY_SIZE(bank); cpu++) {
+		struct u3_diag_bank *b = &bank[cpu];
+
+		pr_info("U3IRQDIAG bank=%u dctl=%08x en=%08x pend=%08x act=%08x target=%08x cctl=%08x pmr=%08x bpr=%08x rpr=%08x hppir=%08x\n",
+			cpu, b->dctl, b->enabled, b->pending, b->active, b->target,
+			b->cctl, b->pmr, b->bpr, b->rpr, b->hppir);
+		pr_info("U3IRQATTR bank=%u p0_3=%08x p4_7=%08x p8_11=%08x p12_15=%08x p28_31=%08x\n",
+			cpu, b->pri[0], b->pri[1], b->pri[2], b->pri[3], b->pri[4]);
+		pr_info("U3IRQDIAG timer=%u tcntb=%08x icntb=%08x tcon=%08x stat=%08x inten=%08x wstat=%08x irqs=%u\n",
+			cpu, b->tcntb, b->icntb, b->tcon, b->status, b->inten,
+			b->wstat, b->irqs);
+	}
+	/* Retain bank0 legacy records only when its implementation range is valid. */
+	if (shared[0].valid) {
+		for (group = 0; group < ARRAY_SIZE(shared[0].enabled); group++)
+			pr_info("U3IRQDIAG spi-group=%u en=%08x pend=%08x act=%08x\n",
+				group + 1, shared[0].enabled[group], shared[0].pending[group],
+				shared[0].active[group]);
+		for (i = 0; i < ARRAY_SIZE(spi_ids); i++)
+			pr_info("U3IRQATTR intid=%u priority_word=%08x target_word=%08x config_word=%08x\n",
+				spi_ids[i], shared[0].spi[i].priority, shared[0].spi[i].target,
+				shared[0].spi[i].config);
+	}
+	pr_info("U3IRQALIAS observers=%u->%u\n", observer_begin, observer_end);
+	for (cpu = 0; cpu < ARRAY_SIZE(shared); cpu++) {
+		struct u3_diag_shared *d = &shared[cpu];
+
+		pr_info("U3IRQALIAS bank=%u typer=%08x iidr=%08x valid=%u\n",
+			cpu, d->typer, d->iidr, d->valid);
+		if (!d->valid)
+			continue;
+		for (group = 0; group < ARRAY_SIZE(d->enabled); group++)
+			pr_info("U3IRQALIAS bank=%u spi-group=%u en=%08x pend=%08x act=%08x\n",
+				cpu, group + 1, d->enabled[group], d->pending[group], d->active[group]);
+		for (i = 0; i < ARRAY_SIZE(spi_ids); i++)
+			pr_info("U3IRQALIAS bank=%u intid=%u priority_word=%08x target_word=%08x config_word=%08x\n",
+				cpu, spi_ids[i], d->spi[i].priority, d->spi[i].target, d->spi[i].config);
+	}
+	if (odroid_u3_i2cdiag_on())
+		for (cpu = 0; cpu < 4; cpu++) {
+			unsigned int ch;
+			for (ch = 0; ch < U3DIAG_CHANNELS; ch++) {
+				struct u3_i2c_progress *p = &progress[cpu][ch];
+				pr_info("U3I2CPROG cpu=%u channel=%u stage=%u count=%u value=%08x aux=%08x pid=%u tick=%u\n",
+						cpu, ch, p->stage, p->count, p->value, p->aux, p->pid, p->tick);
+			}
+		}
+	pr_info("U3IRQDIAG report-complete=%u reason=%s\n",
+		limited ? atomic_read(&u3_diag_reports) + 1 : 0, reason);
+	u3_diag_end_report(limited);
+}
+
+/* Called only from an existing watchdog report, with no printk CPU lock. */
+void odroid_u3_i2cdiag_softlockup(void)
+{
+	/* Enabled only after the U3 observer resources have been validated. */
+	if (!odroid_u3_i2cdiag_on())
+		return;
+	/* Admission and completion share one budget with the RCU hook. */
+	u3_diag_dump("SoftLockup", true);
+}
+
+static void u3_diag_rcu_stall(void *unused, const char *name, const char *message)
+{
+	/* No allocation, sleeping, cross-CPU call or new timer in this hook. */
+	u3_diag_dump(message, true);
+}
+
+static int __init u3_diag_init(void)
+{
+	struct device_node *gic, *mct;
+	struct resource dr, cr, tr;
+	struct irq_data *data;
+	u32 stride;
+	int ret = -ENODEV;
+
+	if (!u3_diag_enabled || !of_machine_is_compatible("hardkernel,odroid-u3"))
+		return 0;
+	gic = of_find_compatible_node(NULL, NULL, "arm,cortex-a9-gic");
+	mct = of_find_compatible_node(NULL, NULL, "samsung,exynos4412-mct");
+	if (!gic || !mct || of_address_to_resource(gic, 0, &dr) ||
+	    of_address_to_resource(gic, 1, &cr) ||
+	    of_address_to_resource(mct, 0, &tr) ||
+	    of_property_read_u32(gic, "cpu-offset", &stride))
+		goto out;
+	if (dr.start != 0x10490000 || resource_size(&dr) != 0x10000 ||
+	    cr.start != 0x10480000 || resource_size(&cr) != 0x10000 ||
+	    tr.start != 0x10050000 || resource_size(&tr) != 0x800 ||
+	    stride != 0x4000)
+		goto out;
+	u3_timer_irq = irq_of_parse_and_map(mct, 4);
+	data = irq_get_irq_data(u3_timer_irq);
+	if (!data || data->hwirq != 28)
+		goto out;
+	u3_dist = ioremap(dr.start, resource_size(&dr));
+	u3_cpu = ioremap(cr.start, resource_size(&cr));
+	u3_mct = ioremap(tr.start, resource_size(&tr));
+	if (!u3_dist || !u3_cpu || !u3_mct) {
+		ret = -ENOMEM;
+		goto unmap;
+	}
+	/* The additional SPI attribute reads require both IDs to be implemented. */
+	if (((readl_relaxed(u3_dist + GIC_DIST_CTR) & 0x1f) + 1) * 32 <= 109) {
+		ret = -ENODEV;
+		goto unmap;
+	}
+	ret = register_trace_rcu_stall_warning(u3_diag_rcu_stall, NULL);
+	if (ret)
+		goto unmap;
+	if (u3_i2c_requested)
+		WRITE_ONCE(odroid_u3_i2cdiag_enabled, true);
+
+	u3_diag_dump("armed", false);
+	goto out;
+unmap:
+	if (u3_dist)
+		iounmap(u3_dist);
+	if (u3_cpu)
+		iounmap(u3_cpu);
+	if (u3_mct)
+		iounmap(u3_mct);
+out:
+	of_node_put(gic);
+	of_node_put(mct);
+	if (ret)
+		pr_err("U3IRQDIAG unavailable: %d\n", ret);
+	return ret;
+}
+core_initcall(u3_diag_init);
+
+/* debugfs_init is a core initcall; register the optional file afterwards. */
+static int __init u3_i2c_debugfs_init(void)
+{
+	struct dentry *entry;
+
+	if (!odroid_u3_i2cdiag_on())
+		return 0;
+	entry = debugfs_create_file("odroid-u3-i2c-progress", 0400, NULL, NULL,
+				    &u3_i2c_progress_fops);
+	if (IS_ERR(entry)) {
+		pr_err("U3I2CPROG debugfs unavailable: %ld\n", PTR_ERR(entry));
+		return PTR_ERR(entry);
+	}
+	return 0;
+}
+late_initcall(u3_i2c_debugfs_init);
