+static inline u32 u3_readl(struct s3c24xx_i2c *i2c, u32 offset)
+{
+	u32 value;
+	u3_i2c_mark(i2c, 100, offset, i2c->state);
+	value = readl(i2c->regs + offset);
+	u3_i2c_mark(i2c, 101, offset, value);
+	return value;
+}
+static inline u8 u3_readb(struct s3c24xx_i2c *i2c, u32 offset)
+{
+	u8 value;
+	u3_i2c_mark(i2c, 104, offset, i2c->state);
+	value = readb(i2c->regs + offset);
+	u3_i2c_mark(i2c, 105, offset, value);
+	return value;
+}
+static inline void u3_writel(struct s3c24xx_i2c *i2c, u32 value, u32 offset)
+{
+	u3_i2c_mark(i2c, 102, offset, value);
+	writel(value, i2c->regs + offset);
+	u3_i2c_mark(i2c, 103, offset, value);
+}
+static inline void u3_writeb(struct s3c24xx_i2c *i2c, u8 value, u32 offset)
+{
+	u3_i2c_mark(i2c, 106, offset, value);
+	writeb(value, i2c->regs + offset);
+	u3_i2c_mark(i2c, 107, offset, value);
+}
 
