+static inline void u3_i2c_mark(struct s3c24xx_i2c *i2c, u32 stage, u32 value, u32 aux)
+{
+	if (unlikely(i2c->u3_diag_target))
+		odroid_u3_i2cdiag_mark(in_hardirq() ? U3DIAG_DRIVER : U3DIAG_PROCESS,
+				       stage, value, aux);
