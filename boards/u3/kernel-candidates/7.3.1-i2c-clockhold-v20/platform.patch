+/* Opt-in U3 I2C0 clock lifetime control; normal transfer code is unchanged. */
+static bool u3_hold_clock;
+static bool u3_clock_held;
+static unsigned long u3_clock_rate;
+module_param_named(u3_hold_clock, u3_hold_clock, bool, 0400);
+module_param_named(u3_clock_held, u3_clock_held, bool, 0444);
+module_param_named(u3_clock_rate, u3_clock_rate, ulong, 0444);
+MODULE_PARM_DESC(u3_hold_clock, "U3 I2C0 keep one managed clock reference");
+
+static void u3_i2c_release_clock(void *clock)
+{
+	WRITE_ONCE(u3_clock_held, false);
+	clk_disable_unprepare(clock);
+}
+
+static int u3_i2c_hold_clock(struct s3c24xx_i2c *i2c)
+{
+	int ret;
+
+	if (!i2c->u3_diag_target || !u3_hold_clock)
+		return 0;
+	ret = clk_prepare_enable(i2c->clk);
+	if (ret)
+		return ret;
+	/* Registered before the IRQ: devres frees the IRQ before this clock. */
+	ret = devm_add_action_or_reset(i2c->dev, u3_i2c_release_clock, i2c->clk);
+	if (ret)
+		return ret;
+	WRITE_ONCE(u3_clock_held, true);
+	WRITE_ONCE(u3_clock_rate, clk_get_rate(i2c->clk));
+	dev_info(i2c->dev, "U3I2CCLK held irq=%u intid=90 rate=%lu\n",
+		 i2c->irq, u3_clock_rate);
+	return 0;
+}
