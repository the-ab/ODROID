+# Private U3 diagnostic profile, inactive without its explicit boot argument.
+obj-$(CONFIG_SOC_EXYNOS4412) += odroid-u3-irqdiag.o
--- /dev/null
+++ b/arch/arm/mach-exynos/odroid-u3-irqdiag.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private, opt-in U3 observation at an existing RCU stall tracepoint. */
+#include <linux/atomic.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/jiffies.h>
+#include <linux/kernel_stat.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/smp.h>
+#include <trace/events/rcu.h>
+
+static bool u3_diag_enabled;
+static void __iomem *u3_dist, *u3_cpu, *u3_mct;
+static unsigned int u3_timer_irq;
+static atomic_t u3_diag_busy = ATOMIC_INIT(0);
+static atomic_t u3_diag_reports = ATOMIC_INIT(0);
+
+static int __init u3_diag_setup(char *value)
+{
+	return !kstrtobool(value, &u3_diag_enabled);
+}
+__setup("odroid_u3_irqdiag=", u3_diag_setup);
+
+struct u3_diag_bank {
+	u32 dctl, enabled, pending, active, target;
+	u32 cctl, pmr, bpr, rpr, hppir;
+	u32 tcntb, icntb, tcon, status, inten, wstat;
+	u32 irqs;
+};
+
+static void u3_diag_dump(const char *reason)
+{
+	struct u3_diag_bank bank[4];
+	u32 high1, low1, high2, low2, global_tcon;
+	u32 shared_enabled[4], shared_pending[4], shared_active[4];
+	unsigned int cpu, group;
+
+	if (atomic_cmpxchg(&u3_diag_busy, 0, 1))
+		return;
+
+	/* All snapshots precede console output. No acknowledge/clear writes. */
+	high1 = readl_relaxed(u3_mct + 0x104);
+	low1 = readl_relaxed(u3_mct + 0x100);
+	global_tcon = readl_relaxed(u3_mct + 0x240);
+	for (cpu = 0; cpu < ARRAY_SIZE(bank); cpu++) {
+		void __iomem *d = u3_dist + cpu * 0x4000;
+		void __iomem *c = u3_cpu + cpu * 0x4000;
+		void __iomem *t = u3_mct + 0x300 + cpu * 0x100;
+		struct u3_diag_bank *b = &bank[cpu];
+
+		b->dctl = readl_relaxed(d);
+		b->enabled = readl_relaxed(d + 0x100);
+		b->pending = readl_relaxed(d + 0x200);
+		b->active = readl_relaxed(d + 0x300);
+		b->target = readl_relaxed(d + 0x800);
+		b->cctl = readl_relaxed(c);
+		b->pmr = readl_relaxed(c + 0x04);
+		b->bpr = readl_relaxed(c + 0x08);
+		b->rpr = readl_relaxed(c + 0x14);
+		b->hppir = readl_relaxed(c + 0x18);
+		b->tcntb = readl_relaxed(t);
+		b->icntb = readl_relaxed(t + 0x08);
+		b->tcon = readl_relaxed(t + 0x20);
+		b->status = readl_relaxed(t + 0x30);
+		b->inten = readl_relaxed(t + 0x34);
+		b->wstat = readl_relaxed(t + 0x40);
+		b->irqs = kstat_irqs_cpu(u3_timer_irq, cpu);
+	}
+	for (group = 0; group < ARRAY_SIZE(shared_enabled); group++) {
+		shared_enabled[group] = readl_relaxed(u3_dist + 0x104 + group * 4);
+		shared_pending[group] = readl_relaxed(u3_dist + 0x204 + group * 4);
+		shared_active[group] = readl_relaxed(u3_dist + 0x304 + group * 4);
+	}
+	high2 = readl_relaxed(u3_mct + 0x104);
+	low2 = readl_relaxed(u3_mct + 0x100);
+
+	pr_info("U3IRQDIAG reason=%s observer=%u irq=%u jiffies=%lu global=%08x:%08x->%08x:%08x gtcon=%08x\n",
+		reason, raw_smp_processor_id(), u3_timer_irq, jiffies,
+		high1, low1, high2, low2, global_tcon);
+	for (cpu = 0; cpu < ARRAY_SIZE(bank); cpu++) {
+		struct u3_diag_bank *b = &bank[cpu];
+
+		pr_info("U3IRQDIAG bank=%u dctl=%08x en=%08x pend=%08x act=%08x target=%08x cctl=%08x pmr=%08x bpr=%08x rpr=%08x hppir=%08x\n",
+			cpu, b->dctl, b->enabled, b->pending, b->active, b->target,
+			b->cctl, b->pmr, b->bpr, b->rpr, b->hppir);
+		pr_info("U3IRQDIAG timer=%u tcntb=%08x icntb=%08x tcon=%08x stat=%08x inten=%08x wstat=%08x irqs=%u\n",
+			cpu, b->tcntb, b->icntb, b->tcon, b->status, b->inten,
+			b->wstat, b->irqs);
+	}
+	for (group = 0; group < ARRAY_SIZE(shared_enabled); group++)
+		pr_info("U3IRQDIAG spi-group=%u en=%08x pend=%08x act=%08x\n",
+			group + 1, shared_enabled[group], shared_pending[group],
+			shared_active[group]);
+	atomic_set(&u3_diag_busy, 0);
+}
+
+static void u3_diag_rcu_stall(void *unused, const char *name, const char *message)
+{
+	/* No allocation, sleeping, cross-CPU call or new timer in this hook. */
+	if (atomic_inc_return(&u3_diag_reports) <= 3)
+		u3_diag_dump(message);
+}
+
+static int __init u3_diag_init(void)
+{
+	struct device_node *gic, *mct;
+	struct resource dr, cr, tr;
+	struct irq_data *data;
+	u32 stride;
+	int ret = -ENODEV;
+
+	if (!u3_diag_enabled || !of_machine_is_compatible("hardkernel,odroid-u3"))
+		return 0;
+	gic = of_find_compatible_node(NULL, NULL, "arm,cortex-a9-gic");
+	mct = of_find_compatible_node(NULL, NULL, "samsung,exynos4412-mct");
+	if (!gic || !mct || of_address_to_resource(gic, 0, &dr) ||
+	    of_address_to_resource(gic, 1, &cr) ||
+	    of_address_to_resource(mct, 0, &tr) ||
+	    of_property_read_u32(gic, "cpu-offset", &stride))
+		goto out;
+	if (dr.start != 0x10490000 || resource_size(&dr) != 0x10000 ||
+	    cr.start != 0x10480000 || resource_size(&cr) != 0x10000 ||
+	    tr.start != 0x10050000 || resource_size(&tr) != 0x800 ||
+	    stride != 0x4000)
+		goto out;
+	u3_timer_irq = irq_of_parse_and_map(mct, 4);
+	data = irq_get_irq_data(u3_timer_irq);
+	if (!data || data->hwirq != 28)
+		goto out;
+	u3_dist = ioremap(dr.start, resource_size(&dr));
+	u3_cpu = ioremap(cr.start, resource_size(&cr));
+	u3_mct = ioremap(tr.start, resource_size(&tr));
+	if (!u3_dist || !u3_cpu || !u3_mct) {
+		ret = -ENOMEM;
+		goto unmap;
+	}
+	ret = register_trace_rcu_stall_warning(u3_diag_rcu_stall, NULL);
+	if (ret)
+		goto unmap;
+	u3_diag_dump("armed");
+	goto out;
+unmap:
+	if (u3_dist)
+		iounmap(u3_dist);
+	if (u3_cpu)
+		iounmap(u3_cpu);
+	if (u3_mct)
+		iounmap(u3_mct);
+out:
+	of_node_put(gic);
+	of_node_put(mct);
+	if (ret)
+		pr_err("U3IRQDIAG unavailable: %d\n", ret);
+	return ret;
+}
+core_initcall(u3_diag_init);
